{"iconType":"icon","icon":"plus","color":"#13315C","hotspots":[{"position":{"x":18.92,"y":18.9,"legacyPositioning":false},"alwaysFullscreen":false,"header":"Línea en f₀ (fundamental)","content":[{"library":"H5P.Text 1.1","params":{"text":"<p>La frecuencia más baja de la señal: f₀ = 1/T.</p>"},"subContentId":"e8b2873f-adce-40df-ac50-f8a63c47176f","metadata":{"contentType":"H5P.Text","license":"U","title":"Línea en f₀ (fundamental)"}}]},{"position":{"x":58.43,"y":68.87,"legacyPositioning":false},"alwaysFullscreen":false,"header":"Líneas en kf₀ (armónicos)","content":[{"library":"H5P.Text 1.1","params":{"text":"<p>Cada línea es un armónico, múltiplo entero de f₀.</p>"},"subContentId":"1e76b8f6-fbc9-4d09-a61a-3a97ec708b61","metadata":{"contentType":"H5P.Text","license":"U","title":"Líneas en kf₀ (armónicos)"}}]},{"position":{"x":38.68,"y":78.46,"legacyPositioning":false},"alwaysFullscreen":false,"header":"Altura de cada línea = |c_k|","content":[{"library":"H5P.Text 1.1","params":{"text":"<p>La magnitud del coeficiente dice cuánto pesa ese armónico.</p>"},"subContentId":"42477a0c-893e-41cd-a89a-414dd8d67b03","metadata":{"contentType":"H5P.Text","license":"U","title":"Altura de cada línea = |c_k|"}}]},{"position":{"x":28.8,"y":86.67,"legacyPositioning":false},"alwaysFullscreen":false,"header":"Separación entre líneas = f₀ = 1/T","content":[{"library":"H5P.Text 1.1","params":{"text":"<p>Entre más largo el periodo, más juntas las líneas.</p>"},"subContentId":"d10372ac-495e-427b-ab11-05927a50a9fb","metadata":{"contentType":"H5P.Text","license":"U","title":"Separación entre líneas = f₀ = 1/T"}}]}],"hotspotNumberLabel":"Punto clave #num","closeButtonLabel":"Cerrar","containsAudioVideoLabel":"Contains Audio/Video","image":{"path":"../../../assets/img/s18.line_spectrum.png","mime":"image/png","width":1600,"height":900,"copyright":{"license":"U"}},"backgroundImageAltText":"Espectro de líneas de una señal periódica"}